      "xhci_pci"
      "ahci"
      "nvme"
      "usb_storage"
      "sd_mod"
      "sdhci_pci"
    ];
    initrd.kernelModules = [ ];
    kernelModules = [ "kvm-intel" ];
    extraModulePackages = [ ];
  };

  fileSystems."/" = {
    device = "/dev/mapper/luks-4c773ccf-0475-470b-ad33-af53dcb29d3e";
    fsType = "ext4";
  };

  boot.initrd.luks.devices."luks-4c773ccf-0475-470b-ad33-af53dcb29d3e".device =
    "/dev/disk/by-uuid/4c773ccf-0475-470b-ad33-af53dcb29d3e";

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/B34C-3D83";
    fsType = "vfat";
    options = [
      "fmask=0077"
      "dmask=0077"
    ];
  };

  swapDevices = [ ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
